        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmElement" minOccurs="0" maxOccurs="unbounded" />
