          <xs:element ref="jar-sign" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="create-provenance-file" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attribute name="ui-multifile-upload" type="switch" use="optional" />
      </xs:extension>
