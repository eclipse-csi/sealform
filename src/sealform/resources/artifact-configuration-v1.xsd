        <xs:attribute name="description-url" type="authenticodeDescriptionUrl" use="optional" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AuthenticodeSignWithHashAlgorithmWithoutLegacyAlgorithmsElement">
    <xs:complexContent>
      <xs:extension base="AuthenticodeSignElementBase">
        <xs:attribute name="hash-algorithm" type="authenticodeHashAlgorithmWithoutLegacyAlgorithmsOrArgumentReference" use="optional" default="sha256" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AuthenticodeSignWithHashAlgorithmElement">
    <xs:complexContent>
      <xs:extension base="AuthenticodeSignElementBase">
        <xs:attribute name="hash-algorithm" type="authenticodeHashAlgorithmOrArgumentReference" use="optional" default="sha256" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

