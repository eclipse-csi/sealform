<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="artifact-configuration"
           targetNamespace="http://signpath.io/artifact-configuration/v1"
           elementFormDefault="qualified"
           xmlns="http://signpath.io/artifact-configuration/v1"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ac="http://signpath.io/artifact-configuration/v1">

  <xs:element name="artifact-configuration" type="ArtifactConfigurationElement" />

  <xs:complexType name="ArtifactConfigurationElement">
    <xs:complexContent>
      <xs:extension base="ArtifactConfigurationElementBase">
        <xs:sequence>
          <xs:element ref="parameters" minOccurs="0" maxOccurs="1" />
          <xs:choice>
            <xs:element name="pe-file" type="RootPeFileElement" />
            <xs:element name="appx-file" type="RootAppxFileElement" />
            <xs:element name="msix-file" type="RootMsixFileElement" />
            <xs:element name="powershell-file" type="RootPowerShellFileElement" />
            <xs:element name="zip-file" type="RootZipFileElement" />
            <xs:element name="msi-file" type="RootMsiFileElement" />
            <xs:element name="cab-file" type="RootCabFileElement" />
            <xs:element name="opc-file" type="RootOpcFileElement" />
            <xs:element name="nupkg-file" type="RootNuPkgFileElement" />
            <xs:element name="jar-file" type="RootJarFileElement" />
            <xs:element name="docker-signing-data-file" type="RootDockerSigningDataFileElement" />
            <xs:element name="catalog-file" type="RootCatalogFileElement" />
            <xs:element name="hash-signing-data-file" type="RootHashSigningDataFileElement" />
            <xs:element name="office-binary-file" type="RootOfficeBinaryFileElement" />
            <xs:element name="office-outlook-macro-file" type="RootOfficeOutlookMacroFileElement" />
            <xs:element name="office-oxml-file" type="RootOfficeOpenXmlFileElement" />
            <xs:element name="office-access-file" type="RootOfficeAccessFileElement" />
            <xs:element name="windows-script-file" type="RootWindowsScriptFileElement" />
            <xs:element name="xml-file" type="RootXmlFileElement" />
            <xs:element name="json-file" type="RootJsonFileElement" />
            <xs:element name="file" type="RootGenericFileElement" />
            <xs:element name="rpm-file" type="RootRpmFileElement" />
            <xs:element name="deb-file" type="RootDebFileElement" />
            <xs:element name="apk-file" type="RootApkFileElement" />
            <xs:element name="oci-image-layout-archive-file" type="RootOciImageLayoutArchiveFileElement" />
          </xs:choice>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:group name="containerItem">
    <xs:choice>
      <xs:element name="pe-file" type="PeFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="pe-file-set" type="PeFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="appx-file" type="AppxFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="appx-file-set" type="AppxFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="msix-file" type="MsixFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="msix-file-set" type="MsixFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="powershell-file" type="PowerShellFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="powershell-file-set" type="PowerShellFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="nupkg-file" type="NuPkgFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="nupkg-file-set" type="NuPkgFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="zip-file" type="ZipFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="zip-file-set" type="ZipFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="msi-file" type="MsiFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="msi-file-set" type="MsiFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="cab-file" type="CabFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="cab-file-set" type="CabFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="opc-file" type="OpcFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="opc-file-set" type="OpcFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="jar-file" type="JarFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="jar-file-set" type="JarFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="docker-signing-data-file" type="DockerSigningDataFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="docker-signing-data-file-set" type="DockerSigningDataFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="hash-signing-data-file" type="HashSigningDataFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="hash-signing-data-file-set" type="HashSigningDataFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="catalog-file" type="CatalogFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="catalog-file-set" type="CatalogFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-binary-file" type="OfficeBinaryFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-binary-file-set" type="OfficeBinaryFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-outlook-macro-file" type="OfficeOutlookMacroFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-outlook-macro-file-set" type="OfficeOutlookMacroFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-oxml-file" type="OfficeOpenXmlFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-oxml-file-set" type="OfficeOpenXmlFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-access-file" type="OfficeAccessFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="office-access-file-set" type="OfficeAccessFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="windows-script-file" type="WindowsScriptFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="windows-script-file-set" type="WindowsScriptFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="xml-file" type="XmlFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="xml-file-set" type="XmlFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="json-file" type="JsonFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="json-file-set" type="JsonFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="file" type="GenericFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="file-set" type="GenericFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="directory" type="DirectoryElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="directory-set" type="DirectorySetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="rpm-file" type="RpmFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="rpm-file-set" type="RpmFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="deb-file" type="DebFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="deb-file-set" type="DebFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="apk-file" type="ApkFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="apk-file-set" type="ApkFileSetElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="oci-image-layout-archive-file" type="OciImageLayoutArchiveFileElement" minOccurs="0" maxOccurs="1" />
      <xs:element name="oci-image-layout-archive-file-set" type="OciImageLayoutArchiveSetElement" minOccurs="0" maxOccurs="1" />
    </xs:choice>
  </xs:group>

  <!-- Parameters -->
  <xs:element name="parameters">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="parameter" type="ParameterElement" minOccurs="0" maxOccurs="20" />
      </xs:sequence>
    </xs:complexType>

    <xs:unique name="parameterNames">
      <xs:selector xpath="ac:parameter" />
      <xs:field xpath="@name" />
    </xs:unique>
  </xs:element>

  <xs:complexType name="ParameterElement">
    <xs:attribute name="name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <!-- When changing this pattern also change the allowed characters in ArtifactConfigurationParameterPropertyDefinitions -->
          <xs:pattern value="[a-zA-Z0-9\-_]+" />
          <xs:maxLength value="100" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="description" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:maxLength value="5000" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="required" type="xs:boolean" use="optional" default="true" />
    <xs:attribute name="default-value" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="^[^\s](.*[^\s])?$" />
          <xs:minLength value="1" />
          <xs:maxLength value="5000" />
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:simpleType name="argumentReference">
    <xs:restriction base="xs:string">
      <!-- When changing this pattern also change the allowed characters in ArtifactConfigurationParameterPropertyDefinitions -->
      <xs:pattern value="\$\{[a-zA-Z0-9\-_]+\}" />
    </xs:restriction>
  </xs:simpleType>

  <!-- PE -->
  <xs:complexType name="RootPeFileElement">
    <xs:complexContent>
      <xs:extension base="RootItemElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmAndAppendElement" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attributeGroup ref="peConstraints" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PeFileElement">
    <xs:complexContent>
      <xs:extension base="ContentItemWithPathElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmAndAppendElement" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="include-in-provenance" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="peConstraints" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PeFileSetElement">
    <xs:complexContent>
      <xs:extension base="SetElementBase">
        <xs:sequence>
          <xs:element name="include" type="PeFileIncludeElement" minOccurs="1" maxOccurs="unbounded" />
          <xs:element name="for-each" type="PeFileSetForEachElement" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attributeGroup ref="peConstraints" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PeFileSetForEachElement">
    <xs:complexContent>
      <xs:extension base="SetForEachElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmAndAppendElement" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="include-in-provenance" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="PeFileIncludeElement">
    <xs:complexContent>
      <xs:extension base="IncludeElementBase">
        <xs:attributeGroup ref="peConstraints" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:attributeGroup name="peConstraints">
    <xs:attribute name="productName" type="xs:string" use="optional" />
    <xs:attribute name="product-name" type="xs:string" use="optional" />
    <xs:attribute name="productVersion" type="xs:string" use="optional" />
    <xs:attribute name="product-version" type="xs:string" use="optional" />
    <xs:attribute name="copyright" type="xs:string" use="optional" />
    <xs:attribute name="file-version" type="xs:string" use="optional" />
    <xs:attribute name="original-filename" type="xs:string" use="optional" />
    <xs:attribute name="company-name" type="xs:string" use="optional" />
  </xs:attributeGroup>

  <!-- APPX -->
  <xs:complexType name="RootAppxFileElement">
    <xs:complexContent>
      <xs:extension base="ContainerRootItemElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmWithoutLegacyAlgorithmsElement" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AppxFileElement">
    <xs:complexContent>
      <xs:extension base="ContainerContentItemElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmWithoutLegacyAlgorithmsElement" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="include-in-provenance" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AppxFileSetElement">
    <xs:complexContent>
      <xs:extension base="SetElementBase">
        <xs:sequence>
          <xs:element name="include" type="AppxFileIncludeElement" minOccurs="1" maxOccurs="unbounded" />
          <xs:element name="for-each" type="AppxFileSetForEachElement" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AppxFileSetForEachElement">
    <xs:complexContent>
      <xs:extension base="ContainerSetForEachElementBase">
        <xs:sequence>
          <xs:element ref="authenticode-verify" minOccurs="0" maxOccurs="1" />
          <xs:element name="authenticode-sign" type="AuthenticodeSignWithHashAlgorithmWithoutLegacyAlgorithmsElement" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="include-in-provenance" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AppxFileIncludeElement">
