      <xs:enumeration value="sha256" />
      <xs:enumeration value="sha384" />
      <xs:enumeration value="sha512" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="hashAlgorithmOrArgumentReference">
    <xs:union memberTypes="hashAlgorithm argumentReference" />
  </xs:simpleType>

  <xs:simpleType name="appendOrArgumentReference">
    <xs:union memberTypes="xs:boolean argumentReference" />
  </xs:simpleType>

