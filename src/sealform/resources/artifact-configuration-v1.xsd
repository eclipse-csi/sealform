    </xs:complexContent>
  </xs:complexType>

  <xs:element name="create-gpg-signature" type="CreateGpgSignatureElement" />
  <xs:complexType name="CreateGpgSignatureElement">
    <xs:complexContent>
      <xs:extension base="DetachedFileSigningDirectiveElementBase">
        <xs:attribute name="output-encoding" use="optional" type="gpgSignatureOutputEncoding" default="ascii-armored" />
        <xs:attribute name="version" use="optional" type="gpgSignatureVersion" default="4" />
        <xs:attribute name="hash-algorithm" use="optional" type="hashAlgorithmOrArgumentReference" default="sha256" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="create-cms-signature" type="CreateCmsSignatureElement" />
  <xs:complexType name="CreateCmsSignatureElement">
    <xs:complexContent>
      <xs:extension base="DetachedFileSigningDirectiveElementBase">
        <xs:attribute name="output-encoding" use="required" type="cmsOutputEncoding" />
        <xs:attribute name="hash-algorithm" use="optional" type="hashAlgorithmOrArgumentReference" default="sha256" />
        <xs:attribute name="rsa-padding" use="optional" type="rsaPadding" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="create-custom-signature" type="CreateCustomSignatureElement" />
  <xs:complexType name="CreateCustomSignatureElement">
    <xs:complexContent>
      <xs:extension base="DetachedFileSigningDirectiveElementBase">
        <xs:attribute name="method" use="required" type="xs:string" />
        <xs:anyAttribute namespace="##local" processContents="skip" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="jsf-sign" type="JsfSignElement" />
  <xs:complexType name="JsfSignElement">
    <xs:complexContent>
      <xs:extension base="FileSigningDirectiveElementBase">
        <xs:attribute name="hash-algorithm" use="optional" type="hashAlgorithmOrArgumentReference" default="sha256" />
        <xs:attribute name="rsa-padding" use="optional" type="rsaPadding" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="smime-sign" type="SmimeSignElement" />
  <xs:complexType name="SmimeSignElement">
    <xs:complexContent>
      <xs:extension base="EnvelopedFileSigningDirectiveElementBase">
        <xs:attribute name="normalization" use="optional" type="smimeNormalization" default="line-endings" />
        <xs:attribute name="hash-algorithm" use="optional" type="hashAlgorithmOrArgumentReference" default="sha256" />
        <xs:attribute name="rsa-padding" use="optional" type="rsaPadding" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="custom-sign" type="CustomSignElement" />
  <xs:complexType name="CustomSignElement">
    <xs:complexContent>
      <xs:extension base="FileSigningDirectiveElementBase">
        <xs:attribute name="method" use="required" type="xs:string" />
        <xs:anyAttribute namespace="##local" processContents="skip" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="keyInfoX509DataOrArgumentReference">
    <xs:union memberTypes="keyInfoX509Data argumentReference" />
  </xs:simpleType>

  <xs:simpleType name="keyInfoX509Data">
    <xs:restriction base="xs:string">
      <!-- When adding a new possible value do not forget to adapt the KeyInfoX509DataParser -->
      <xs:enumeration value="none" />
      <xs:enumeration value="leaf" />
      <xs:enumeration value="exclude-root" />
      <xs:enumeration value="whole-chain" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="fileName">
    <xs:restriction base="xs:string">
      <!-- Any word character and '.', ',', '!', '$', '%', '&', '=', '(', ')', '{', '}', '[', ']', '+', '-', '_', ' ' -->
      <xs:pattern value="^[\w.,!$%&amp;=(){}[\]+\-_ ]{1,250}$" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="cmsOutputEncoding">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pem" />
      <xs:enumeration value="der" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="smimeNormalization">
    <xs:restriction base="xs:string">
      <xs:enumeration value="line-endings" />
      <xs:enumeration value="none" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="hashAlgorithm">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sha256" />
      <xs:enumeration value="sha384" />
      <xs:enumeration value="sha512" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="rsaPadding">
    <xs:restriction base="xs:string">
      <xs:enumeration value="pkcs1" />
      <xs:enumeration value="pss" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gpgSignatureOutputEncoding">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ascii-armored" />
      <xs:enumeration value="binary" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="gpgSignatureVersion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="4" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Verification Types -->
  <xs:complexType name="VerificationDirectiveElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ArtifactConfigurationElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FileVerificationDirectiveElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="VerificationDirectiveElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="DirectoryVerificationDirectiveElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="VerificationDirectiveElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="authenticode-verify" type="AuthenticodeVerifyElement" />
  <xs:complexType name="AuthenticodeVerifyElement">
    <xs:complexContent>
      <xs:extension base="FileVerificationDirectiveElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <!-- Provenance -->
  <xs:element name="create-attestation-signature" type="CreateAttestationSignatureElement" />
  <xs:complexType name="CreateAttestationSignatureElement">
    <xs:complexContent>
      <xs:extension base="DetachedFileSigningDirectiveElementBase">
        <xs:attribute name="type" use="optional" default="cms">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="100" />
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="create-provenance-file" type="CreateProvenanceFileElement" />
  <xs:complexType name="CreateProvenanceFileElement">
    <xs:complexContent>
      <xs:extension base="ContentItemElementBase">
        <xs:sequence>
          <xs:element ref="create-attestation-signature" minOccurs="0" maxOccurs="unbounded" />
          <xs:element ref="create-verification-summary-file" minOccurs="0" maxOccurs="1" />
        </xs:sequence>
        <xs:attribute name="output-file-name" use="required" type="fileName" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="create-verification-summary-file" type="CreateVerificationSummaryFileElement">
  </xs:element>
  <xs:complexType name="CreateVerificationSummaryFileElement">
    <xs:complexContent>
      <xs:extension base="AttestationItemElementBase">
        <xs:sequence>
          <xs:element ref="create-attestation-signature" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="output-file-name" use="required" type="fileName" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:element name="include-in-provenance" type="IncludeInProvenanceElement" />
  <xs:complexType name="IncludeInProvenanceElement">
    <xs:complexContent>
      <xs:extension base="ItemElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <!-- Base classes -->
  <xs:complexType name="ArtifactConfigurationElementBase" abstract="true">
    <!-- Exists to have a base class for every element to store the element's line number/position in the generated C# code -->
  </xs:complexType>

  <xs:complexType name="ItemElementBase" abstract="true">
    <!-- Base class for all items (files, containers, directories) -->
    <xs:complexContent>
      <xs:extension base="ArtifactConfigurationElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="RootItemElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ItemElementBase">
        <xs:attributeGroup ref="optionalPath" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContainerRootItemElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="RootItemElementBase">
        <xs:group ref="containerItem" minOccurs="1" maxOccurs="unbounded" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContentItemElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ItemElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="AttestationItemElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ItemElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContentSingleFileElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ContentItemElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContentItemWithPathElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ContentSingleFileElementBase">
        <xs:attributeGroup ref="pathAndMatches" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContainerContentItemElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ContentItemWithPathElementBase">
        <xs:group ref="containerItem" minOccurs="1" maxOccurs="unbounded" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="IncludeElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ItemElementBase">
        <xs:attributeGroup ref="pathAndMatches" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="SetElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ContentItemElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:attributeGroup name="pathAndMatches">
    <xs:attribute name="path" type="xs:string" use="required" />
    <xs:attribute name="min-matches" type="positiveIntOrArgumentReference" default="1" use="optional" />
    <xs:attribute name="max-matches" type="positiveIntUnboundedOrArgumentReference" default="1" use="optional" />
  </xs:attributeGroup>

  <xs:attributeGroup name="optionalPath">
    <xs:attribute name="path" type="xs:string" use="optional" />
  </xs:attributeGroup>

  <xs:complexType name="SetForEachElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="ArtifactConfigurationElementBase" />
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="ContainerSetForEachElementBase" abstract="true">
    <xs:complexContent>
      <xs:extension base="SetForEachElementBase">
        <xs:group ref="containerItem" minOccurs="1" maxOccurs="unbounded" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:simpleType name="positiveIntOrArgumentReference">
    <xs:union memberTypes="positiveInt argumentReference" />
  </xs:simpleType>

  <xs:simpleType name="positiveInt">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="positiveIntUnboundedOrArgumentReference">
    <xs:union memberTypes="positiveIntUnbounded argumentReference" />
  </xs:simpleType>

  <xs:simpleType name="positiveIntUnbounded">
    <xs:annotation>
      <xs:documentation>for maxOccurs</xs:documentation>
    </xs:annotation>
    <xs:union memberTypes="positiveInt">
      <xs:simpleType>
        <xs:restriction base="xs:NMTOKEN">
          <xs:enumeration value="unbounded" />
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="switch">
    <xs:restriction base="xs:string">
      <xs:enumeration value="on" />
      <xs:enumeration value="off" />
    </xs:restriction>
  </xs:simpleType>
</xs:schema>